<!--
  On-screen touch HUD (ScreenSpace) — LANDSCAPE build.

  This project's `screenOrientation` is Portrait, so the PORTRAIT sibling is the
  build currently wired. This file ships for a later orientation switch: if you
  wire it instead, TouchControlsHud.landscape / TouchJoystick.landscape /
  TouchCameraLook.landscape must all be set true so the landscape hit rects and
  zone splits are selected. Wire exactly one HUD build.

      d:DesignWidth / d:DesignHeight   2340 x 1080
      ReferenceResolution              2340,1080

  ROOT STRUCTURE follows creating-custom-ui: a <Component> wrapping a single
  noesis:LayoutScaler whose one child is a Grid. LayoutScaler scales the
  2340x1080 (19.5:9, matching the Figma frame) design space onto the device.
  CRITICAL: set the panel's
  CustomUiPlatformComponent width AND height to 0 explicitly so the layout size is
  inherited from d:DesignWidth/d:DesignHeight above. With d:Design ==
  ReferenceResolution and width/height = 0, the LayoutScaler collapses to an
  identity transform and only ONE net scale applies. Do NOT leave width/height
  absent: an unset panel defaults to 1920x1080 and double-scales this 2340x1080
  panel. Setting them (or the legacy vrLayoutWidth/Height) to any other nonzero
  value double-scales the same way.

  The Canvas is HorizontalAlignment/VerticalAlignment=Stretch with no explicit
  Width/Height, so it fills the scaled design space and Canvas.Right/Canvas.Bottom
  anchor to the physical screen corner.

  Buttons sit in a bottom-right thumb cluster, matching the built-in
  GameplayControls. Landscape gives more horizontal room, so the cluster sits
  slightly further from the corner than portrait. Jump (160, jump tier) is the
  corner button; Interact and Drop (110, utility tier) are CONTEXTUAL, authored
  hidden and shown only by their project-glue bridges. Drop sits directly above
  Jump with a 27px gap (Jump's top edge is at Canvas.Bottom 543). Each button
  shows a white gameplay icon (copied to UI/icons/, referenced project-root-
  relative), not text.

  INPUT COMES FROM THE ROUTER, NOT NOESIS. Touch is delivered by the shared
  TouchRouter, so these buttons have NO Command bindings and are display-only
  visuals; the entity's CustomUiPlatformComponent.isInteractable can be false.
  Each button's hit region is a normalized rect in TouchControlsHud.ts
  (BUTTON_CONFIGS, landscape set); the Canvas position and size below MUST match
  that rect, and TouchControlsHud.landscape MUST be true so the landscape rects
  are selected.

  Each button's pressed visual (a press-down ScaleTransform) binds to its
  `*Pressed` flag, which the router handlers set; Visibility and IsEnabled bind to
  the `*Visible` / `*Enabled` flags so the wrapper API still toggles them.

  The rest ScaleTransform is a Style <Setter> in TouchButtonStyle ON PURPOSE: a
  Style DataTrigger can override a Style setter but NOT a LOCAL value. Never move
  the rest RenderTransform/ScaleTransform onto the Button/Grid element as a local
  value, or the *Pressed DataTrigger loses precedence (Noesis: local > style
  trigger > style setter) and the press visual silently dies on tap AND hold.
-->
<Component
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="2340"
  d:DesignHeight="1080">
  <noesis:LayoutScaler ReferenceResolution="2340,1080">
    <Grid>
      <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Canvas.Resources>
          <!-- Shared round touch-button style, identical to the portrait build:
               monochrome translucent theme matching the built-in
               GameplayControls.xaml. -->
          <Style x:Key="TouchButtonStyle" TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
              <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </Setter.Value>
            </Setter>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="bg">
                    <Ellipse Stretch="UniformToFill" StrokeThickness="1">
                      <Ellipse.Fill>
                        <SolidColorBrush Color="#FF000000" Opacity="0.4" />
                      </Ellipse.Fill>
                      <Ellipse.Stroke>
                        <SolidColorBrush Color="#FFFFFFFF" Opacity="0.2" />
                      </Ellipse.Stroke>
                    </Ellipse>
                    <ContentPresenter
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="bg" Property="Opacity" Value="0.4" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Canvas.Resources>

        <!-- Jump: jump tier, bottom-right corner. 160px. Rect must match
             BUTTON_CONFIGS 'Jump' (landscape) in TouchControlsHud.ts. -->
        <Button
          Width="160"
          Height="160"
          Canvas.Right="153"
          Canvas.Bottom="383"
          IsEnabled="{Binding Path=jumpEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_Jump.png"
              Width="136"
              Height="136"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding jumpPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="jumpVisible" FallbackValue="Visible">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Interact: utility tier, 110px, left of and below the Jump cluster.
             CONTEXTUAL — shown by InteractionControlsBridge on WSDK candidacy.
             Rect must match BUTTON_CONFIGS 'Interact' (landscape). -->
        <Button
          Width="110"
          Height="110"
          Canvas.Right="300"
          Canvas.Bottom="140"
          IsEnabled="{Binding Path=interactEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_Interact.png"
              Width="94"
              Height="94"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding interactPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="interactVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

        <!-- Drop: utility tier, 110px, directly above Jump (centred on Jump's
             x axis, 27px above its top edge). CONTEXTUAL — shown by
             AttachableControlsBridge while a droppable object is held. Rect must
             match BUTTON_CONFIGS 'Drop' (landscape). -->
        <Button
          Width="110"
          Height="110"
          Canvas.Right="178"
          Canvas.Bottom="570"
          IsEnabled="{Binding Path=dropEnabled}">
          <Button.Content>
            <Image
              Source="UI/icons/icn_Drop.png"
              Width="94"
              Height="94"
              Stretch="Uniform" />
          </Button.Content>
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TouchButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding dropPressed}" Value="True">
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.Visibility>
            <Binding Path="dropVisible" FallbackValue="Collapsed">
              <Binding.Converter>
                <BooleanToVisibilityConverter />
              </Binding.Converter>
            </Binding>
          </Button.Visibility>
        </Button>

      </Canvas>
    </Grid>
  </noesis:LayoutScaler>
</Component>
